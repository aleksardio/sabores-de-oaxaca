meta {
  name: Editar receta propia
  type: http
  seq: 20
}
put {
  url: {{baseUrl}}/api/v1/mis-recetas/{{recetaId}}
  body: json
  auth: bearer
}
auth:bearer {
  token: {{jwtCocinero}}
}
body:json {
  {"version":{{version}},"titulo":"Receta editada","descripcion":"Preparación de prueba","preparacion":"Mezclar y cocinar.","tipo":"COMUN","porcionesBase":4,"categorias":[{{categoriaId}}],"ingredientes":[{"ingredienteId":{{ingredienteId}},"cantidad":1,"unidad":"G","orden":1}],"multimedia":[]}
}
tests {
  test("Editar: 200", function () { expect(res.getStatus()).to.equal(200); });
}
