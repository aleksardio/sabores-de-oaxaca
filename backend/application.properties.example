# Ejemplo de variables de entorno; no incluir credenciales reales.
# DB_URL=jdbc:mysql://localhost:3306/sabores_oaxaca?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
# DB_USERNAME=nombre_de_usuario
# DB_PASSWORD=contraseña_local
# Activar el perfil dev para usar estas variables y habilitar Flyway.
# La configuración está en src/main/resources/application-dev.properties.
# Variables SMS (opcionales; no configurar claves reales aquí)
# SMS_HABILITADO=false
# INFOBIP_BASE_URL=https://<cuenta>.api.infobip.com
# INFOBIP_API_KEY=<clave-solo-en-entorno-privado>
# INFOBIP_SENDER=<remitente-autorizado>
# SMS_DESTINO=+52XXXXXXXXXX
# SMS_INTERVALO_SEGUNDOS=300
